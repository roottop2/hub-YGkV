# 复制本文件为 .env 后填入自己的密钥。
# .env 已被 .gitignore 忽略，不会提交到 git。

# ---- DeepSeek（负责所有 LLM 调用）----
DEEPSEEK_API_KEY=sk-你的deepseek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Bocha（负责网页搜索）----
BOCHA_API_KEY=sk-你的bocha密钥
BOCHA_SEARCH_URL=https://api.bocha.cn/v1/web-search

# ---- 研究行为参数 ----
# 最多研究几轮（超过就强制出报告）
RESEARCH_MAX_ROUNDS=3
# 每个关键词取多少条搜索结果
SEARCH_COUNT=10
# LLM 返回空内容时的自动重试次数
LLM_RETRIES=3
